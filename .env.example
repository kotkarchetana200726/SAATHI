# SAATHI - Environment Configuration (Vercel & AI Studio Compatible)

# Optional: Gemini API Key for server-side or extended AI features
# Not required for frontend MVP or offline Web Speech API operation.
GEMINI_API_KEY=""

# Public Application URL (Automatically supplied by Vercel or Cloud Run)
VITE_APP_URL="https://saathi-care.vercel.app"
APP_URL="https://saathi-care.vercel.app"

# Optional: Analytics or Sentry DSN (leave empty for local/MVP deployment)
VITE_PUBLIC_ENV="production"
